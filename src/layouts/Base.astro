---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/libre-caslon-display/400.css';
import '../styles/global.css';
import { site } from '../lib/site';
import { getFooter, isExternal, segments, NETWORKS } from '../lib/footer';
import SocialIcon from '../components/SocialIcon.astro';

const { title, description = site.description, image, type = 'website', active = '' } = Astro.props as {
  title?: string; description?: string; image?: string; type?: string; active?: string;
};
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — Biblioteca digital`;
const img = new URL(image ?? '/og-default.png', Astro.url.origin).href;
const footer = await getFooter();
const year = String(new Date().getFullYear());
const nav = [['Inicio', '/', 'inicio'], ['Biblioteca', '/catalogo', 'biblioteca'], ['Artículos', '/articulos', 'articulos'], ['Manifiesto', '/#manifiesto', 'manifiesto'], ['Acerca', '/acerca', 'acerca']];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#fafafa" />
  <title>{fullTitle}</title>
  <link rel="icon" href="/icono.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/atom+xml;profile=opds-catalog;kind=navigation" href="/opds" title={`${site.name} (OPDS)`} />
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.url.origin + Astro.url.pathname + (Astro.url.pathname === '/catalogo' ? Astro.url.search : '')} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:image" content={img} />
  <meta name="twitter:card" content="summary_large_image" />
  <slot name="head" />
  <ClientRouter />
</head>
<body id="top">
  <div class="site-shell">
    <header class="site-header">
      <div class="masthead">
        <button class="menu-button" aria-label="Abrir menú" aria-expanded="false"><span></span><span></span><span></span></button>
        <a class="wordmark" href="/" aria-label={site.name}>
          {site.logo ? <img class="logo-img" src={site.logo} alt="" width="166" height="40" /> : <b>{site.initial}</b>}
          {!(site.logo && site.logoOnly) && <span>{site.nameLines[0]}<br />{site.nameLines[1]}</span>}
        </a>
        <nav class="main-nav" aria-label="Principal">
          {nav.map(([label, href, key], i) => <a href={href} class={active === key ? 'active' : ''} style={`--i:${i}`}>{label}</a>)}
        </nav>
        <a class="head-link" href="/catalogo#buscar" aria-label="Buscar">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
          <span>Buscar</span>
        </a>
      </div>
      <div class="progress" aria-hidden="true"></div>
    </header>
    <!--email_off-->
    <main><slot /></main>
    <footer class="site-footer">
      <div class="foot-wrap">
        <div class="foot-brand">
          <a class="footer-mark" href="/" aria-label={site.name}>{site.logoFooter ? <img src={site.logoFooter} alt="" width="340" height="31" /> : site.name}</a>
          {footer.tagline && <p>{footer.tagline}</p>}
          {footer.social.length > 0 && (
            <ul class="foot-social" aria-label="Redes sociales">
              {footer.social.map((s) => <li><a href={s.url} aria-label={NETWORKS[s.network]} title={NETWORKS[s.network]} target={s.network === 'email' ? undefined : '_blank'} rel={s.network === 'email' ? undefined : 'noopener noreferrer'}><SocialIcon network={s.network} /></a></li>)}
            </ul>
          )}
        </div>
        {footer.columns.length > 0 && (
          <div class="foot-cols" style={`--n:${footer.columns.length}`}>
            {footer.columns.map((c) => (
              <section class="foot-col">
                {c.title && <h2>{c.title}</h2>}
                {c.text && <div class="foot-text">{c.text.split('\n').map((line) => <p>{segments(line).map((g) => g.href ? <a href={g.href}>{g.text}</a> : g.text)}</p>)}</div>}
                {c.links.length > 0 && <ul>{c.links.map((l) => <li><a href={l.url} target={isExternal(l.url) ? '_blank' : undefined} rel={isExternal(l.url) ? 'noopener noreferrer' : undefined}>{l.label}</a></li>)}</ul>}
              </section>
            ))}
          </div>
        )}
      </div>
      <div class="foot-bottom"><small>{[footer.note, year].filter(Boolean).join(' · ')}</small><a class="to-top" href="#top">Subir ↑</a></div>
    </footer>
    <!--/email_off-->
  </div>
  <script>import '../scripts/motion'; import '../scripts/search';</script>
</body>
</html>
