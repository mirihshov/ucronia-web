---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { getAbout } from '../lib/about';
import { blocks, isExternal } from '../lib/about-form';
const about = await getAbout();
const vars = { origen: Astro.url.origin, nombre: site.name, correo: site.contactEmail };
---
<Base title={about.title} description={`${site.name}: qué es, criterios de publicación, contacto y avisos legales.`}>
  <article class="prose">
    <h1>{about.title}</h1>
    {about.sections.map((s) => (
      <>
        <h2 id={s.id}>{s.title}</h2>
        {blocks(s.body, vars).map((p) => (
          <p>{p.map((line, i) => (
            <>{i > 0 && <br />}{line.map((seg) => seg.href
              ? <a href={seg.href} rel={isExternal(seg.href) ? 'noopener' : undefined}>{seg.text}</a>
              : seg.text)}</>
          ))}</p>
        ))}
      </>
    ))}
  </article>
</Base>
