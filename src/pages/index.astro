---
import Base from '../layouts/Base.astro';
import BookCard from '../components/BookCard.astro';
import { listBooks, getCategories, coverUrl, coverVariant, markOf } from '../lib/catalog';
import { listArticles, excerptOf, readingMinutes, formatDate } from '../lib/articles';
import { getSlides } from '../lib/settings';
import { site } from '../lib/site';
const [{ books: featured }, { books: latest, total }, slides, categories, { articles }] = await Promise.all([
  listBooks({ featured: true, limit: 6 }), listBooks({ limit: 6 }), getSlides(), getCategories(), listArticles({ limit: 8, withBody: true }),
]);
const coverOf = (b: any) => `book-cover cover-${coverVariant(b.id)}${coverUrl(b.cover_key) ? ' has-img' : ''}`;
const words = (t: string) => t.split(' ');
const many = slides.length > 1;
const pad = (n: number) => String(n).padStart(2, '0');
const indexLabel = (i: number) => site.heroIndex.replace(/\d+$/, String(i + 1).padStart(3, '0'));
const INTERVAL = 7000; // ms que dura cada titular
---
<Base active="inicio">
  <section class="hero" data-hero data-interval={INTERVAL} role="region" aria-roledescription="carrusel" aria-label="Titulares de la biblioteca">
    <figure class="hero-image">
      {slides.map((s, i) => (
        <div class={`hero-img${i === 0 ? ' on' : ''}`} data-slide={i} aria-hidden={i === 0 ? undefined : 'true'}>
          <div class="kb"><img src={s.image} alt={s.imageAlt} style={`object-position:${s.focus}`} fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'} decoding={i === 0 ? undefined : 'async'} /></div>
          <span class="image-index">{indexLabel(i)}</span>
          {s.caption && <figcaption>{s.caption}</figcaption>}
        </div>
      ))}
    </figure>
    <div class="hero-copy">
      <div class="hero-slides">
        {slides.map((s, i) => (
          <div class={`hero-slide${i === 0 ? ' on' : ''}`} data-slide={i} role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${slides.length}`}>
            {s.kicker && <p class="kicker">{s.kicker}</p>}
            <h1 aria-label={s.title}>{words(s.title).map((w, j) => <><span class="w" aria-hidden="true"><span style={`--i:${j}`}>{w}</span></span>{' '}</>)}</h1>
            {s.deck && <p class="hero-deck">{s.deck}</p>}
          </div>
        ))}
      </div>
      <form class="search-box" action="/catalogo" method="get" role="search" data-suggest>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
        <input name="q" placeholder="Título, autor, género o etiqueta…" aria-label="Buscar en la biblioteca" />
        <button>Buscar</button>
      </form>
      {categories.length > 0 && (
        <nav class="chips" aria-label="Explorar por categoría"><span>Explorar</span>{categories.slice(0, 6).map((c) => <a href={`/catalogo?categoria=${c.slug}`}>{c.name}</a>)}</nav>
      )}
      <p class="index-note"><span data-count={total}>{total}</span> {total === 1 ? 'título publicado' : 'títulos publicados'} · Descarga gratuita en EPUB</p>
    </div>
    {many && (
      <>
        <button type="button" class="hero-arrow prev" data-hero-prev aria-label="Titular anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
        <button type="button" class="hero-arrow next" data-hero-next aria-label="Titular siguiente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
      </>
    )}
  </section>

  {featured.length > 0 && (
    <section class="catalog featured" id="destacados" data-feat data-interval="6500">
      <div class="catalog-head" data-reveal>
        <div><p class="kicker">Elegidos por los editores</p><h2>Selección destacada</h2></div>
        <a class="text-link" href="/catalogo">Ver todo el catálogo <span>→</span></a>
      </div>
      <div class={`feat${featured.length > 1 ? '' : ' solo'}`}>
        <div class="feat-stage" data-feat-stage>
          {featured.map((b, i) => (
            <article class={`feat-panel${i === 0 ? ' on' : ''}`} id={`feat-p${i}`} data-feat-panel>
              <div class="feat-cover">
                <a class={coverOf(b)} href={`/libro/${b.slug}`} tabindex="-1" aria-hidden="true">
                  {coverUrl(b.cover_key)
                    ? <img src={coverUrl(b.cover_key)!} alt="" width="250" height="375" decoding="async" loading={i === 0 ? undefined : 'lazy'} />
                    : <><span>{b.language.toUpperCase()}</span><strong>{markOf(b.title)}</strong><i>{b.year ?? ''}</i></>}
                </a>
              </div>
              <div class="feat-copy">
                <p class="feat-eyebrow" style="--k:0"><b>{pad(i + 1)}</b>{[b.category?.name, b.year].filter(Boolean).join(' · ') || 'Destacado'}</p>
                <h3 style="--k:1"><a href={`/libro/${b.slug}`}>{b.title}</a></h3>
                <p class="feat-author" style="--k:2">{b.author}</p>
                {b.description && <p class="feat-desc" style="--k:3">{b.description}</p>}
                {b.tags.length > 0 && <ul class="book-tags" aria-label="Etiquetas" style="--k:4">{b.tags.slice(0, 4).map((t) => <li><a href={`/catalogo?q=${encodeURIComponent(t)}`}>{t}</a></li>)}</ul>}
                <span class="feat-more" style="--k:5">Ver ficha <i>→</i></span>
              </div>
            </article>
          ))}
        </div>
        {featured.length > 1 && (
          <ol class="feat-list" data-feat-list aria-label="Títulos destacados">
            {featured.map((b, i) => (
              <li class={i === 0 ? 'is-active' : ''}>
                <a href={`/libro/${b.slug}`} data-feat-tab>
                  <span class="n" aria-hidden="true">{pad(i + 1)}</span>
                  <span class={coverOf(b)} aria-hidden="true">
                    {coverUrl(b.cover_key)
                      ? <img src={coverUrl(b.cover_key)!} alt="" loading="lazy" decoding="async" width="48" height="72" />
                      : <strong>{markOf(b.title)}</strong>}
                  </span>
                  <span class="t"><b>{b.title}</b><small>{[b.author, b.category?.name].filter(Boolean).join(' · ')}</small></span>
                  <span class="go" aria-hidden="true">→</span>
                  <i class="fbar" aria-hidden="true"></i>
                </a>
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>
  )}

  {articles.length > 0 && (
    <section class={`articles${articles.length < 2 ? ' static' : ''}`} id="articulos" data-articles data-interval="8000" role="region" aria-roledescription="carrusel" aria-label="Artículos">
      <div class="articles-head" data-reveal>
        <div><p class="kicker">Lecturas</p><h2>Artículos</h2></div>
        <div class="articles-ctrl">
          <p class="art-count" aria-hidden="true"><b data-art-cur>{pad(1)}{articles.length > 1 ? `–${pad(Math.min(2, articles.length))}` : ''}</b> / {pad(articles.length)}</p>
          <button type="button" class="art-btn" data-art-prev aria-label="Artículos anteriores"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
          <button type="button" class="art-btn" data-art-next aria-label="Artículos siguientes"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
        </div>
      </div>
      <div class="art-bar" aria-hidden="true"><i data-art-bar></i></div>
      <div class="art-track" data-art-track data-reveal>
        {articles.map((a, i) => (
          <article class="art-slide" role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${articles.length}`}>
            <a class={`art-card${a.cover_key ? ' has-cover' : ''}`} href={`/articulo/${a.slug}`}>
              {a.cover_key && <figure class="art-cover"><img src={coverUrl(a.cover_key)!} alt="" loading="lazy" decoding="async" width="640" height="360" /></figure>}
              <p class="art-meta"><span>{a.kicker ?? 'Artículo'}</span><span>{formatDate(a.published_at)}</span></p>
              <h3>{a.title}</h3>
              {a.subtitle && <p class="art-sub">{a.subtitle}</p>}
              <p class="art-excerpt">{excerptOf(a, 230)}</p>
              <p class="art-foot"><span>{a.source ?? a.author ?? ''}</span><span>{readingMinutes(a.body)} min</span></p>
              <span class="art-go">Leer artículo <i>→</i></span>
            </a>
          </article>
        ))}
      </div>
      <a class="art-all" href="/articulos">Todos los artículos <span>→</span></a>
    </section>
  )}

  <section class="catalog" id="recientes">
    <div class="catalog-head" data-reveal>
      <div><p class="kicker">Recién llegados</p><h2>Últimas incorporaciones</h2></div>
      <p>Los títulos más recientes de la colección abierta.</p>
    </div>
    {latest.length
      ? <div class="books-grid">{latest.map((b, i) => <BookCard book={b} i={i} />)}</div>
      : <div class="empty-state"><p>Aún no hay libros</p><h3>La colección se está preparando.</h3></div>}
    {latest.length > 0 && <a class="more-button" href="/catalogo">Ver todo el catálogo <span>→</span></a>}
  </section>

  <section class="manifesto" id="manifiesto">
    <div class="manifesto-head">
      <p class="kicker" data-reveal>Manifiesto</p>
      <blockquote data-scrub aria-label={site.quote}>{words(site.quote).map((w) => <><span class="sw" aria-hidden="true">{w}</span>{' '}</>)}</blockquote>
      <p class="attribution" data-reveal>{site.quoteBy}</p>
      <p class="m-count" aria-hidden="true"><span>Principio</span> <b data-m-cur>01</b> <i></i> {pad(site.principles.length)}</p>
    </div>
    <div class="manifesto-body">
      <p class="lead" data-reveal>{site.manifestoLead}</p>
      <ol class="principles">
        {site.principles.map((p, i) => (
          <li data-reveal style={`--i:${i}`}><span class="num">{pad(i + 1)}</span><h3>{p.title}</h3><p>{p.text}</p></li>
        ))}
      </ol>
      <a class="manifesto-link" href="/acerca#criterios" data-reveal>Criterios de publicación <span>↗</span></a>
    </div>
  </section>
</Base>
