---
import Base from '../../layouts/Base.astro';
import { getArticle, listArticles, renderBody, excerptOf, readingMinutes, formatDate } from '../../lib/articles';
import { site } from '../../lib/site';
const a = await getArticle(Astro.params.slug!);
if (!a) return new Response('Artículo no encontrado', { status: 404 });
const { articles: related } = await listArticles({ limit: 3, exclude: a.id, withBody: true });
const html = renderBody(a.body);
const mins = readingMinutes(a.body);
const desc = excerptOf(a, 160) || site.description;
const ld = {
  '@context': 'https://schema.org', '@type': 'Article', headline: a.title, ...(a.subtitle ? { alternativeHeadline: a.subtitle } : {}),
  datePublished: a.published_at, inLanguage: 'es', ...(a.author ? { author: { '@type': 'Person', name: a.author } } : {}),
  publisher: { '@type': 'Organization', name: site.name }, url: Astro.url.href, description: desc,
};
const jsonLd = JSON.stringify(ld).replace(/</g, '\\u003c');
---
<Base title={a.title} description={desc} type="article" active="articulos">
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <article class="art">
    <header class="art-hero">
      {a.kicker && <p class="art-kicker">{a.kicker}</p>}
      <h1>{a.title}</h1>
      {a.subtitle && <p class="art-sub">{a.subtitle}</p>}
      {a.source && <p class="art-source">{a.source}</p>}
      <p class="art-by">{[a.author, formatDate(a.published_at), `${mins} min de lectura`].filter(Boolean).join(' · ')}</p>
    </header>
    <div class="art-body" lang="es" set:html={html} />
    <div class="art-end"><a href="/articulos">← Todos los artículos</a><a href="#top">Subir ↑</a></div>
  </article>
  {related.length > 0 && (
    <section class="art-related" id="relacionados" aria-labelledby="rel-title">
      <p class="kicker">Seguir leyendo</p>
      <h2 id="rel-title">Artículos relacionados</h2>
      <ul class="art-rel-list">
        {related.map((r) => (
          <li><a href={`/articulo/${r.slug}`}>
            <small>{[r.kicker, formatDate(r.published_at)].filter(Boolean).join(' · ')}</small>
            <b>{r.title}</b>
            {r.subtitle && <em>{r.subtitle}</em>}
            <span>Leer <i>→</i></span>
          </a></li>
        ))}
      </ul>
    </section>
  )}
  {related.length > 0 && <a class="art-tab" href="#relacionados" aria-label="Ir a artículos relacionados"><span class="ar" aria-hidden="true">↓</span><span class="tx">Artículos relacionados</span><span class="ar" aria-hidden="true">↓</span></a>}
</Base>
